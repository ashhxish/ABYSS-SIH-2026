# ============================================================================
# ABYSS — AI-Powered Maritime Forensic Intelligence System
# Environment configuration TEMPLATE
# ============================================================================
# Usage:
#   cp .env.example .env      # then optionally fill in credentials
#
# HARD RULES
#   * .env is git-ignored. Never commit real credentials.
#   * DEMO MODE MUST WORK WITH THIS FILE AS-IS (nothing filled in).
#   * Never hard-code credentials anywhere in source code.
#
# Two modes are supported (see docs/architecture.md):
#   demo -> bundled deterministic dataset. No credentials. Always available.
#   live -> external providers; every value below is optional and the system
#           falls back to demo data with a visible warning when a provider
#           is unconfigured or unreachable.
# ============================================================================

# ---------------------------------------------------------------------------
# 1. Runtime mode
# ---------------------------------------------------------------------------
ABYSS_DATA_MODE=demo
DEMO_CASE_ID=CASE-001

# ---------------------------------------------------------------------------
# 2. PostgreSQL / PostGIS
#    These are ABYSS-owned local development values, not third-party secrets.
# ---------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=abyss
POSTGRES_USER=abyss
POSTGRES_PASSWORD=change_me_local_dev_only

# ---------------------------------------------------------------------------
# 3. Spring Boot backend  (owns the /api/* contract)
# ---------------------------------------------------------------------------
BACKEND_PORT=8080
ABYSS_INTELLIGENCE_BASE_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# 4. Python intelligence service  (owns the analysis pipeline)
# ---------------------------------------------------------------------------
INTELLIGENCE_PORT=8000
INTELLIGENCE_LOG_LEVEL=INFO
# Optional: override where the service reads/writes datasets
# ABYSS_DATA_DIR=./data
# Optional: override the demo AIS CSV used by the demo provider
# Default (committed, synthetic, deterministic): the CASE-001 bundle
# ABYSS_DEMO_AIS_CSV=./intelligence/data/demo/case_001/ais/demo_ais_positions.csv

# ---------------------------------------------------------------------------
# 5. Frontend (Vite — only variables prefixed with VITE_ reach the browser)
# ---------------------------------------------------------------------------
VITE_ABYSS_API_BASE_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# 6. OPTIONAL external scientific providers — LIVE MODE ONLY
#
#    Leave ALL of these blank for DEMO MODE.
#
#    AUTHENTICATION METHOD: NOT VERIFIED IN THIS REPOSITORY.
#    "Authentication method needs verification from the official provider
#     documentation."
#    Provider auth flows change (OAuth tokens vs username/password vs personal
#    access tokens). Verify at the official provider before enabling live mode,
#    then record the outcome in docs/api-keys.md.
#    Do NOT guess an endpoint, token format or registration URL from memory.
# ---------------------------------------------------------------------------
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=
CDS_API_URL=
CDS_API_KEY=
